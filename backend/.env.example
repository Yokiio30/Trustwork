# Which shared/deployments/<NETWORK>.json to use (localhost | sepolia)
NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
PORT=4000
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
DB_PATH=./data/trustwork.db
# Durable store for document text (job descriptions, deliverables, evidence). Use a free Postgres such as
# Neon or Supabase when the host wipes local disk on restart (e.g. Render free tier). Optional locally.
DOCS_DATABASE_URL=
# Set to false only for a local Postgres without TLS
# DOCS_DB_SSL=false
# Indexer
INDEXER_POLL_MS=3000
INDEXER_CHUNK_BLOCKS=2000
# Blocks to wait before indexing (use 2-3 on public testnets to avoid reorgs)
INDEXER_CONFIRMATIONS=0
